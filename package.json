{
  "name": "katha-studio",
  "version": "1.0.1",
  "description": "Katha Studio — professional screenwriting for Indian film and OTT (Tamil, Telugu, Hindi, Malayalam, Kannada)",
  "main": "electron/main.cjs",
  "scripts": {
    "fonts": "node scripts/copy-fonts.mjs",
    "dev": "npm run fonts && vite",
    "build": "npm run fonts && vite build",
    "build:desktop": "node scripts/build-desktop.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "electron": "node scripts/build-desktop.mjs && electron .",
    "dist:win": "node scripts/build-desktop.mjs && electron-builder --win --publish never",
    "test:menus:web": "node tests/e2e/web-menu.cjs",
    "test:menus:desktop": "node scripts/build-desktop.mjs && node tests/e2e/desktop-html-menu.cjs && node tests/e2e/desktop-menu.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adijustadi01/katha-studio.git"
  },
  "keywords": [],
  "author": "Katha Studio",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/adijustadi01/katha-studio/issues"
  },
  "homepage": "https://github.com/adijustadi01/katha-studio#readme",
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.5",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "@anthropic-ai/sdk": "^1.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/noto-sans-kannada": "^5.3.0",
    "@fontsource/noto-sans-malayalam": "^5.3.0",
    "@fontsource/noto-sans-tamil": "^5.3.0",
    "@fontsource/noto-sans-telugu": "^5.3.0",
    "@fontsource/noto-serif-tamil": "^5.3.0",
    "@fontsource/noto-serif-telugu": "^5.3.0",
    "jszip": "^3.10.2",
    "preact": "^11.0.2",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.4",
    "prosemirror-view": "^1.42.8"
  },
  "private": true,
  "type": "module",
  "build": {
    "appId": "studio.katha.app",
    "productName": "Katha Studio",
    "copyright": "Copyright © 2026 Katha Studio contributors",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist-desktop/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "katha",
        "name": "Katha Studio Script",
        "description": "Katha Studio screenplay project",
        "role": "Editor",
        "icon": "build/icon.ico"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Katha-Studio-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Katha Studio",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "adijustadi01",
        "repo": "katha-studio",
        "releaseType": "release"
      }
    ],
    "releaseInfo": {
      "releaseNotes": "Katha Studio — screenwriting for Indian film & OTT.\n\n**v1.0.1 — menu bar fix.** The top menus (File, Edit, View…) no longer open and instantly close or run New screenplay on Windows. Menus open with one click and stay open; items run only on a deliberate click or Enter; Alt/F10 + arrow keys work; long menus and submenus stay inside small or scaled screens; the window always fits the screen. Installed copies update automatically.\n\nDownload the **Katha-Studio-Setup-….exe** file below and double-click it. If Windows shows \"Windows protected your PC\", click **More info → Run anyway** (the installer is not code-signed yet).\n\nWeb version: https://adijustadi01.github.io/katha-studio/"
    }
  }
}
